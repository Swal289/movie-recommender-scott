# TMDB key for the Express server (server/src/config.ts).
# Optional for now: if empty, the server falls back to VITE_TMDB_API_KEY.
TMDB_API_KEY=

# TMDB key for the React client.
# Vite copies every VITE_* variable into the browser bundle, where anyone can read it,
# so never prefix secrets with VITE_.
VITE_TMDB_API_KEY=insertHere

VITE_FRONTEND_PORT=5173
BACKEND_PORT=5000

# MongoDB connection string. If empty or unreachable, the server starts in degraded mode
# (outside production) and /api/health returns 503.
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Set to "production" to make a failed MongoDB connection stop the server from starting.
# NODE_ENV=

# Signs login session cookies. Required when NODE_ENV=production; a development secret is used otherwise.
SESSION_SECRET=

# --- Placeholders for upcoming features (leave commented out until needed) ---
# Secret for signing auth tokens (Member 1)
# JWT_SECRET=
# OpenAI API key for /api/llm-recommender (OPENAI_API_KEY also works)
LLM_API_KEY=

# Set to true to fill the AI recommendation card with TMDB recommendations instead of
# calling the LLM, so the UI can be worked on without an OpenAI key.
# VITE_AI_MOCK=true
